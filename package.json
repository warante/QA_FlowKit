{
  "name": "qa-flowkit",
  "version": "0.5.1-beta.0",
  "description": "Portable open-source framework and npm CLI for AI-assisted QA workflows.",
  "type": "module",
  "bin": {
    "qa-flowkit": "./bin/qa-flowkit.mjs"
  },
  "files": [
    "bin/",
    ".qa-ai/",
    "!.qa-ai/state/",
    "!.qa-ai/agents/specialists/active.md",
    "docs/qa-ai/",
    "README.md",
    "README.es.md",
    "CHANGELOG.md",
    "ROADMAP.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint bin/ .qa-ai/scripts/ .github/scripts/ eslint.config.mjs",
    "lint:fix": "eslint --fix bin/ .qa-ai/scripts/ .github/scripts/ eslint.config.mjs",
    "format": "prettier --write \"**/*.{mjs,json,yml,yaml,md}\" \"!node_modules/**\" \"!.qa-flowkit-npm-*/**\"",
    "format:check": "prettier --check \"**/*.{mjs,json,yml,yaml,md}\" \"!node_modules/**\" \"!.qa-flowkit-npm-*/**\"",
    "qa:init": "node .qa-ai/scripts/init.mjs",
    "qa:config": "node .qa-ai/scripts/config.mjs",
    "qa:bootstrap": "node .qa-ai/scripts/bootstrap-agent-adapters.mjs",
    "qa:doctor": "node .qa-ai/scripts/doctor.mjs",
    "qa:clean": "node .qa-ai/scripts/clean.mjs",
    "qa:validate-features": "node .qa-ai/scripts/validate-features.mjs",
    "qa:organize-features": "node .qa-ai/scripts/organize-features.mjs",
    "qa:validate-karate-features": "node .qa-ai/scripts/validate-karate-features.mjs",
    "qa:validate-traceability": "node .qa-ai/scripts/validate-traceability.mjs",
    "qa:validate-sync-plan": "node .qa-ai/scripts/validate-sync-plan.mjs",
    "qa:validate-active-specialists": "node .qa-ai/scripts/validate-active-specialists.mjs",
    "qa:validate-target": "node .qa-ai/scripts/validate-target.mjs",
    "qa:help": "node .qa-ai/scripts/qa-help.mjs",
    "qa:run": "node .qa-ai/scripts/qa-run.mjs",
    "qa:validate-contract": "node .qa-ai/scripts/validate-workflow-contract.mjs",
    "qa:test-harness": "node .qa-ai/scripts/test-harness.mjs",
    "qa:validate-release-gate": "node .qa-ai/scripts/validate-release-gate.mjs",
    "qa:validate-test-design": "node .qa-ai/scripts/validate-test-design.mjs",
    "qa:sync-adapters": "node .qa-ai/scripts/sync-agent-adapters.mjs",
    "qa:test-validators": "node .qa-ai/scripts/test-validators.mjs",
    "qa:test-cli": "node .qa-ai/scripts/test-cli-integration.mjs",
    "qa:smoke": "node .qa-ai/scripts/smoke-test.mjs",
    "qa:smoke-npm": "node .qa-ai/scripts/smoke-npm-pack.mjs",
    "validate:oss-extraction": "node .qa-ai/scripts/doctor.mjs && node .qa-ai/scripts/validate-workflow-contract.mjs && node .qa-ai/scripts/validate-features.mjs --allow-empty && node .qa-ai/scripts/validate-karate-features.mjs --allow-empty && node .qa-ai/scripts/validate-traceability.mjs --allow-empty --allow-missing && node .qa-ai/scripts/validate-sync-plan.mjs --allow-empty --allow-missing && node .qa-ai/scripts/validate-active-specialists.mjs --allow-missing && node .qa-ai/scripts/test-validators.mjs && node .qa-ai/scripts/test-harness.mjs && node .qa-ai/scripts/test-cli-integration.mjs && node .qa-ai/scripts/smoke-test.mjs && node .qa-ai/scripts/smoke-npm-pack.mjs"
  },
  "keywords": [
    "qa",
    "testing",
    "ai-agents",
    "gherkin",
    "testrail",
    "webdriverio",
    "playwright",
    "codex",
    "claude-code",
    "gemini-cli",
    "qa-flowkit"
  ],
  "homepage": "https://github.com/warante/QA_FlowKit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warante/QA_FlowKit.git"
  },
  "bugs": {
    "url": "https://github.com/warante/QA_FlowKit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "release-please": "^17.6.1"
  }
}
