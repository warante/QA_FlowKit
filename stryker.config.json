{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["html", "json", "clear-text", "progress-append-only"],
  "testRunner": "command",
  "commandRunner": {
    "command": "node .github/scripts/run-mutation-tests.mjs"
  },
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 1000,
  "timeoutFactor": 1.5,
  "mutate": [
    ".qa-ai/scripts/lib/gherkin-validate.mjs",
    ".qa-ai/scripts/lib/test-coverage.mjs",
    ".qa-ai/scripts/lib/markdown-table.mjs",
    ".qa-ai/scripts/lib/secret-patterns.mjs",
    ".qa-ai/scripts/lib/injection-patterns.mjs"
  ]
}
