{
  "schemaVersion": 1,
  "trackOrder": {
    "quick": ["context", "intake", "normalize", "gherkin", "traceability", "pr"],
    "standard": [
      "context",
      "intake",
      "normalize",
      "test-design-system",
      "test-design-rf",
      "gherkin",
      "tm-coverage",
      "tm-sync",
      "traceability",
      "feasibility",
      "ui-impl",
      "api-impl",
      "jira",
      "pr"
    ],
    "enterprise": [
      "context",
      "intake",
      "normalize",
      "test-design-system",
      "test-design-rf",
      "gherkin",
      "tm-coverage",
      "tm-sync",
      "traceability",
      "feasibility",
      "ui-impl",
      "api-impl",
      "jira",
      "pr",
      "release-gate"
    ]
  },
  "phases": [
    {
      "id": "context",
      "name": "QA context intake",
      "slashCommand": "/qa-init",
      "guidance": [".qa-ai/agents/qa-context-intake-agent.md", ".qa-ai/workflows/context-intake.md"],
      "inputs": [],
      "outputs": [
        {
          "path": "$config.knowledge.summaryPath",
          "fallback": "qa-ai-output/qa-knowledge-summary.md"
        }
      ],
      "entryApprovals": [],
      "validators": [],
      "skipConditions": [{ "field": "knowledge.enabled", "equals": false }],
      "permissions": {
        "createLocal": "allowed",
        "modifyExisting": "approval",
        "externalWrite": "denied",
        "delete": "denied"
      }
    },
    {
      "id": "intake",
      "name": "Requirements intake",
      "slashCommand": "/qa-full-flow",
      "guidance": [".qa-ai/agents/requirements-intake-agent.md", ".qa-ai/workflows/intake.md"],
      "inputs": [],
      "outputs": [{ "path": "qa-ai-output/requirement-analysis.md" }],
      "entryApprovals": [],
      "validators": [],
      "skipConditions": [],
      "permissions": {
        "createLocal": "allowed",
        "modifyExisting": "approval",
        "externalWrite": "denied",
        "delete": "denied"
      }
    },
    {
      "id": "normalize",
      "name": "Requirements normalization",
      "slashCommand": "/qa-full-flow",
      "guidance": [".qa-ai/agents/requirements-normalization-agent.md"],
      "inputs": [],
      "outputs": [{ "path": "qa-ai-output/normalized-requirements.md" }],
      "entryApprovals": [],
      "validators": [],
      "skipConditions": [],
      "permissions": {
        "createLocal": "allowed",
        "modifyExisting": "approval",
        "externalWrite": "denied",
        "delete": "denied"
      }
    },
    {
      "id": "test-design-system",
      "name": "System test design",
      "slashCommand": "/qa-full-flow",
      "guidance": [".qa-ai/agents/test-design-system-agent.md", ".qa-ai/workflows/test-design-system.md"],
      "inputs": [],
      "outputs": [{ "path": "$config.testDesign.systemPath", "fallback": "qa-ai-output/test-design-system.md" }],
      "entryApprovals": [],
      "validators": ["validate-test-design"],
      "skipConditions": [{ "field": "project.qaTrack", "equals": "quick" }],
      "permissions": {
        "createLocal": "allowed",
        "modifyExisting": "approval",
        "externalWrite": "denied",
        "delete": "denied"
      }
    },
    {
      "id": "test-design-rf",
      "name": "Per-RF test design",
      "slashCommand": "/qa-full-flow",
      "guidance": [".qa-ai/agents/gherkin-test-design-agent.md", ".qa-ai/workflows/test-design.md"],
      "inputs": [],
      "outputs": [{ "path": "$config.testDesign.proposalPath", "fallback": "qa-ai-output/test-design-proposal.md" }],
      "entryApprovals": [],
      "validators": ["validate-test-design"],
      "skipConditions": [{ "field": "project.qaTrack", "equals": "quick" }],
      "permissions": {
        "createLocal": "allowed",
        "modifyExisting": "approval",
        "externalWrite": "denied",
        "delete": "denied"
      }
    },
    {
      "id": "gherkin",
      "name": "Gherkin feature generation",
      "slashCommand": "/qa-full-flow",
      "guidance": [".qa-ai/agents/gherkin-test-design-agent.md", ".qa-ai/workflows/test-design.md"],
      "inputs": [
        {
          "path": "$config.testDesign.proposalPath",
          "fallback": "qa-ai-output/test-design-proposal.md",
          "required": false
        }
      ],
      "outputs": [{ "path": "$config.gherkin.featurePath", "fallback": "features", "kind": "featureFiles" }],
      "entryApprovals": ["test-design"],
      "requiresRfId": true,
      "validators": ["validate-features"],
      "skipConditions": [],
      "permissions": {
        "createLocal": "allowed",
        "modifyExisting": "approval",
        "externalWrite": "denied",
        "delete": "denied"
      }
    },
