      "inputs": [],
      "outputs": [{ "path": "qa-ai-output/testrail-coverage-analysis.md" }],
      "entryApprovals": [],
      "validators": [],
      "skipConditions": [
        { "field": "project.qaTrack", "equals": "quick" },
        { "field": "tools.testManagement", "notConfigured": true }
      ],
      "permissions": {
        "createLocal": "allowed",
        "modifyExisting": "approval",
        "externalWrite": "denied",
        "delete": "denied"
      }
    },
