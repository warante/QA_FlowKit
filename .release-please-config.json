          "jsonpath": "$.qaFlowKitVersion"
        },
        {
          "type": "json",
          "path": "docs/qa-ai/readiness-audit.v1.json",
          "jsonpath": "$.qaFlowKitVersion"
        },
        {
          "type": "json",
          "path": "docs/qa-ai/required-checks.v1.json",
          "jsonpath": "$.qaFlowKitVersion"
        },
        {
          "type": "json",
          "path": "docs/qa-ai/stable-announcement.v1.json",
          "jsonpath": "$.qaFlowKitVersion"
        },
        {
          "type": "json",
          "path": "docs/qa-ai/stable-post-publish.v1.json",
          "jsonpath": "$.qaFlowKitVersion"
        },
        {
          "type": "json",
          "path": "docs/qa-ai/stable-public-entrypoints.v1.json",
          "jsonpath": "$.qaFlowKitVersion"
        },
        {
          "type": "json",
          "path": "docs/qa-ai/stable-release-approval.v1.json",
          "jsonpath": "$.qaFlowKitVersion"
        },
        {
          "type": "json",
          "path": "docs/qa-ai/stable-release-config.v1.json",
          "jsonpath": "$.qaFlowKitVersion"
        },
        {
          "type": "json",
          "path": "docs/qa-ai/stable-release-pr.v1.json",
